# Copy this file to ".env" in the app folder and fill in your values.
# Every value can also be edited from the app: [ SETTINGS ] > TRANSCRIPTION / ANALYSIS (LLM).
# Lines starting with "#" are comments. Empty values fall back to the defaults shown below.

# --- LLM (any OpenAI-compatible chat completions endpoint; developed against a local 9router) ---
# API key for the endpoint. Required for the analysis step (transcription works without it).
NINEROUTER_API_KEY=
# Endpoint base URL. Default: http://localhost:20128/v1
NINEROUTER_BASE_URL=http://localhost:20128/v1
# Model id used for the analysis. No default: set it here or pick one in Settings (PICK MODEL lists what your endpoint offers).
NINEROUTER_MODEL=

# --- App defaults ---
# Interface and report language: ID or EN. Default: ID
APP_LANG=EN
# Default audio language: Auto, Indonesia, English, Melayu, Mandarin, Japanese, Korean or Arabic. Default: Indonesia
AUDIO_LANG=Indonesia

# --- Where Whisper runs ---
# Local = this computer (GPU if CUDA is available, otherwise CPU) or Colab = a GPU server in Google Colab. Default: Local
WHISPER_ENGINE=Local
# Only for the Colab engine. The notebook prints a "URL TOKEN" line; both values change every Colab session.
COLAB_WHISPER_URL=
COLAB_WHISPER_TOKEN=
